[Desktop Entry]
Type=Application
Name=小喵 Player
Name[en]=Xiaomiao Player
Comment=Linux 移植版播放器 (VA-API 硬解)
Exec=/usr/bin/xiaomiao-player %f
Icon=xiaomiao-player
Terminal=false
# GTK 程序上报的 WM_CLASS 是 application-id（com.azxcvn.moumou），不是可执行
# 文件名，也不等于 .desktop 的文件名（xiaomiao-player.desktop）。三者对不上时
# GNOME 的 dock/任务栏认不出窗口归属，就显示通用占位图标（从"应用程序"里点开
# 却正常，因为那条路直接读 .desktop、不需要匹配窗口）。这里写实际观测到的值。
StartupWMClass=com.azxcvn.moumou
Categories=AudioVideo;Video;Player;
MimeType=video/mp4;video/x-matroska;video/x-msvideo;video/webm;video/mpeg;video/quicktime;
StartupNotify=true
